# --- Option A (preferred): Vertex AI via Application Default Credentials ---
# No secret stored; uses your `gcloud auth application-default login`.
# Billing goes to this GCP project.
LIVECASTER_VERTEX_PROJECT=
# LIVECASTER_VERTEX_LOCATION=us-central1

# --- Option B: Gemini Developer API key — https://aistudio.google.com/apikey ---
# GEMINI_API_KEY=
# For a Vertex AI express-mode key (AQ.…), also set:
# LIVECASTER_USE_VERTEXAI=true

# --- Optional ---
# Live model override. Defaults: gemini-live-2.5-flash-native-audio (Vertex)
# or gemini-2.5-flash-native-audio-preview-09-2025 (Developer API).
# LIVECASTER_LIVE_MODEL=

# Comma-separated CORS origins (defaults to localhost dev ports)
# LIVECASTER_ALLOWED_ORIGINS=http://localhost:5173
